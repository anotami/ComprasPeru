---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import BackToTop from "../components/BackToTop.astro";
import Analytics from "../components/Analytics.astro";
import site from "../data/site.json";
import { withBase } from "../lib/site";

interface Props {
  title: string;
  description: string;
  /** Ruta interna, ej. "/moto". Usar "/" para el home. */
  path: string;
  /** slug de la categoría (para data-niche) */
  niche?: string;
  /** color de acento de la categoría */
  accent?: string;
  accentWash?: string;
  /** ruta de imagen para Open Graph (dentro de /public) */
  ogImage?: string;
  ogType?: string;
}

const {
  title,
  description,
  path,
  niche,
  accent,
  accentWash,
  ogImage = "/og/default.svg",
  ogType = "website",
} = Astro.props;

const origin = Astro.site ?? new URL(site.url);
const canonical = new URL(withBase(path), origin).href;
const ogImageUrl = new URL(withBase(ogImage), origin).href;
const htmlStyle =
  accent && accentWash ? `--accent:${accent};--accent-wash:${accentWash}` : undefined;
---

<!doctype html>
<html lang={site.idioma} data-niche={niche} style={htmlStyle}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="theme-color" content="#F5F1E8" />
    <meta name="author" content={site.autor} />

    <!-- Open Graph -->
    <meta property="og:site_name" content={site.nombre} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content={site.locale} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="icon" href={withBase("/favicon.svg")} type="image/svg+xml" />

    <!-- marca <html class="js"> lo antes posible para el reveal progresivo -->
    <script is:inline>document.documentElement.classList.add("js");</script>

    <!-- Tipografías -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Syne:wght@700;800&family=Manrope:wght@400;500;700&family=JetBrains+Mono:wght@500;700&display=swap"
    />

    <ClientRouter />
    <Analytics />
    <slot name="head" />
  </head>
  <body>
    <div class="scroll-progress" aria-hidden="true" transition:persist></div>
    <a class="skip-link" href="#main">Saltar al contenido</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <BackToTop />

    <script>
      // Reveal en cascada al entrar en viewport. Se re-ejecuta tras cada
      // navegación con View Transitions.
      function initReveal() {
        const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
        const els = document.querySelectorAll(
          ".reviews > .product, .subcat-grid > .subcat-card, .niche-grid > .niche-card, .howto > li, .faq > details, .section-head, .compare, .midcta",
        );
        if (reduce || !("IntersectionObserver" in window)) {
          els.forEach((el) => el.classList.add("is-visible"));
          return;
        }
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add("is-visible");
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: "0px 0px -8% 0px", threshold: 0.05 },
        );
        els.forEach((el) => {
          el.classList.add("reveal");
          io.observe(el);
        });
        // red de seguridad: si a los 1.8s algo sigue oculto pero ya está en
        // pantalla, mostrarlo igual (por si el IO no dispara).
        setTimeout(() => {
          document.querySelectorAll(".reveal:not(.is-visible)").forEach((el) => {
            const r = el.getBoundingClientRect();
            if (r.top < innerHeight && r.bottom > 0) el.classList.add("is-visible");
          });
        }, 1800);
      }
      // clic saliente -> analítica + contador del producto (si hay)
      function initOutbound() {
        document.addEventListener(
          "click",
          (ev) => {
            const a = ev.target.closest?.('a[rel~="sponsored"]');
            if (!a) return;
            const name = a.getAttribute("data-cta") || a.href;
            const cat = a.getAttribute("data-cat") || "";
            const rank = a.getAttribute("data-rank") || "";
            window.plausible?.("Clic afiliado", { props: { producto: name } });
            window.umami?.track?.("clic-afiliado", { producto: name });
            if (window.goatcounter && cat && rank) {
              window.goatcounter.count({
                path: "click/" + cat + "/" + rank,
                title: "Clic: " + name,
                event: true,
              });
            }
          },
          { capture: true },
        );
      }

      // GoatCounter: registrar la vista de página (no_onload:true -> lo hacemos aquí)
      function sendPageview() {
        window.goatcounter?.count?.({ path: location.pathname + location.search });
      }

      // Leer contadores públicos de GoatCounter y mostrarlos.
      async function gcCount(path) {
        const base = window.__gcCounter;
        if (!base) return null;
        try {
          const key = "gc:" + path;
          const cached = sessionStorage.getItem(key);
          if (cached) return +cached;
          const r = await fetch(base + "/" + path.replace(/^\//, "") + ".json");
          if (!r.ok) return null;
          const j = await r.json();
          const n = parseInt(String(j.count_unique ?? j.count ?? "").replace(/[^\d]/g, ""), 10);
          if (!isNaN(n)) sessionStorage.setItem(key, String(n));
          return isNaN(n) ? null : n;
        } catch {
          return null;
        }
      }

      async function initCounters() {
        if (!window.__gcCounter) return;
        // Visitas de esta página + total del sitio
        const vc = document.querySelector("[data-visit-counter]");
        if (vc) {
          const [page, total] = await Promise.all([
            gcCount(location.pathname),
            gcCount("TOTAL"),
          ]);
          const pageEl = vc.querySelector("[data-vc-page]");
          const totalEl = vc.querySelector("[data-vc-total]");
          if (page && page >= 30 && pageEl)
            pageEl.textContent = page.toLocaleString("es") + " visitas a esta página";
          if (total && total >= 100 && totalEl)
            totalEl.textContent =
              (pageEl && pageEl.textContent ? " · " : "") +
              total.toLocaleString("es") + " en total";
          if ((pageEl && pageEl.textContent) || (totalEl && totalEl.textContent))
            vc.hidden = false;
        }
        // Clics por producto (perezoso, solo lo que está o entra en pantalla)
        const marks = [...document.querySelectorAll("[data-clickcount]")];
        if (!marks.length) return;
        const load = async (el) => {
          const n = await gcCount("click/" + el.getAttribute("data-clickcount"));
          if (n && n >= 5) {
            el.textContent = "🔥 " + n.toLocaleString("es") + " fueron a AliExpress";
            el.hidden = false;
          }
        };
        if ("IntersectionObserver" in window) {
          const io = new IntersectionObserver((es) => {
            for (const e of es)
              if (e.isIntersecting) {
                io.unobserve(e.target);
                load(e.target);
              }
          });
          marks.forEach((m) => io.observe(m));
        } else {
          marks.forEach(load);
        }
      }

      let outboundDone = false;
      const runAll = () => {
        initReveal();
        sendPageview();
        initCounters();
        if (!outboundDone) {
          outboundDone = true;
          initOutbound();
        }
      };
      if (document.readyState === "loading")
        document.addEventListener("DOMContentLoaded", runAll, { once: true });
      else runAll();
      document.addEventListener("astro:page-load", runAll);
</script>
  </body>
</html>
