---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import BackToTop from "../components/BackToTop.astro";
import Analytics from "../components/Analytics.astro";
import site from "../data/site.json";
import { withBase } from "../lib/site";

interface Props {
  title: string;
  description: string;
  /** Ruta interna, ej. "/moto". Usar "/" para el home. */
  path: string;
  /** slug de la categoría (para data-niche) */
  niche?: string;
  /** color de acento de la categoría */
  accent?: string;
  accentWash?: string;
  /** ruta de imagen para Open Graph (dentro de /public) */
  ogImage?: string;
  ogType?: string;
}

const {
  title,
  description,
  path,
  niche,
  accent,
  accentWash,
  ogImage = "/og/default.svg",
  ogType = "website",
} = Astro.props;

const origin = Astro.site ?? new URL(site.url);
const canonical = new URL(withBase(path), origin).href;
const ogImageUrl = new URL(withBase(ogImage), origin).href;
const htmlStyle =
  accent && accentWash ? `--accent:${accent};--accent-wash:${accentWash}` : undefined;
---

<!doctype html>
<html lang={site.idioma} data-niche={niche} style={htmlStyle}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="theme-color" content="#F5F1E8" />
    <meta name="author" content={site.autor} />

    <!-- Open Graph -->
    <meta property="og:site_name" content={site.nombre} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content={site.locale} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="icon" href={withBase("/favicon.svg")} type="image/svg+xml" />

    <!-- marca <html class="js"> lo antes posible para el reveal progresivo -->
    <script is:inline>document.documentElement.classList.add("js");</script>

    <!-- Tipografías -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Syne:wght@700;800&family=Manrope:wght@400;500;700&family=JetBrains+Mono:wght@500;700&display=swap"
    />

    <ClientRouter />
    <Analytics />
    <slot name="head" />
  </head>
  <body>
    <div class="scroll-progress" aria-hidden="true" transition:persist></div>
    <a class="skip-link" href="#main">Saltar al contenido</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <BackToTop />

    <script>
      // Reveal en cascada al entrar en viewport. Se re-ejecuta tras cada
      // navegación con View Transitions.
      function initReveal() {
        const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
        const els = document.querySelectorAll(
          ".reviews > .product, .subcat-grid > .subcat-card, .niche-grid > .niche-card, .howto > li, .faq > details, .section-head, .compare, .midcta",
        );
        if (reduce || !("IntersectionObserver" in window)) {
          els.forEach((el) => el.classList.add("is-visible"));
          return;
        }
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add("is-visible");
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: "0px 0px -8% 0px", threshold: 0.05 },
        );
        els.forEach((el) => {
          el.classList.add("reveal");
          io.observe(el);
        });
        // red de seguridad: si a los 1.8s algo sigue oculto pero ya está en
        // pantalla, mostrarlo igual (por si el IO no dispara).
        setTimeout(() => {
          document.querySelectorAll(".reveal:not(.is-visible)").forEach((el) => {
            const r = el.getBoundingClientRect();
            if (r.top < innerHeight && r.bottom > 0) el.classList.add("is-visible");
          });
        }, 1800);
      }
      // clic saliente -> analítica (si hay)
      function initOutbound() {
        document.addEventListener(
          "click",
          (ev) => {
            const a = ev.target.closest?.('a[rel~="sponsored"]');
            if (!a) return;
            const name = a.getAttribute("data-cta") || a.href;
            window.plausible?.("Clic afiliado", { props: { producto: name } });
            window.umami?.track?.("clic-afiliado", { producto: name });
          },
          { capture: true },
        );
      }
      let outboundDone = false;
      const runAll = () => {
        initReveal();
        if (!outboundDone) {
          outboundDone = true;
          initOutbound();
        }
      };
      if (document.readyState === "loading")
        document.addEventListener("DOMContentLoaded", runAll, { once: true });
      else runAll();
      document.addEventListener("astro:page-load", runAll);
</script>
  </body>
</html>
