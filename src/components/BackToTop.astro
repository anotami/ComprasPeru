<button
  class="to-top"
  type="button"
  aria-label="Volver arriba"
  data-to-top
  transition:persist
>
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M12 19V5M5 12l7-7 7 7" />
  </svg>
</button>

<script>
  // transition:persist mantiene el botón entre navegaciones; el listener global
  // se registra una sola vez.
  if (!(window as any).__toTopInit) {
    (window as any).__toTopInit = true;
    const toggle = () => {
      document
        .querySelector("[data-to-top]")
        ?.classList.toggle("is-visible", window.scrollY > 700);
    };
    window.addEventListener("scroll", toggle, { passive: true });
    document.addEventListener("astro:page-load", toggle);
    document.addEventListener("click", (ev) => {
      if ((ev.target as Element)?.closest?.("[data-to-top]")) {
        window.scrollTo({ top: 0, behavior: "smooth" });
      }
    });
    toggle();
  }
</script>
