---
interface Props {
  text: string;
  cta?: string;
  href?: string;
}

const {
  text,
  cta = "Ver el ranking completo",
  href = "#tabla",
} = Astro.props;
---

<aside class="midcta">
  <p set:html={text}></p>
  <a class="btn-cta" href={href}>
    {cta} <span class="arrow" aria-hidden="true">→</span>
  </a>
</aside>
