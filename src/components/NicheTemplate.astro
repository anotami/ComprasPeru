---
import site from "../data/site.json";
import faq from "../data/faq.json";
import { fechaLarga } from "../lib/format";
import { withBase, tpl } from "../lib/site";
import CompareTable from "./CompareTable.astro";
import ProductCard from "./ProductCard.astro";
import type { Product } from "./ProductCard.astro";
import MidCta from "./MidCta.astro";
import Faq from "./Faq.astro";
import StickyCta from "./StickyCta.astro";

export interface Subcat {
  slug: string;
  nombre: string;
  kicker: string;
  intro: string;
  queries: string[];
}

export interface Category {
  slug: string;
  nombre: string;
  nav: string;
  emoji: string;
  accent: string;
  accentWash: string;
  kicker: string;
  h1: string;
  subtitulo: string;
  title: string;
  meta: string;
  intro: string;
  queries: string[];
  subcategorias?: Subcat[];
}

interface Props {
  cat: Category;
  products: Product[];
  /** si viene, la página es de subcategoría */
  sub?: Subcat | null;
}

const { cat, products, sub = null } = Astro.props;
const origin = Astro.site ?? new URL(site.url);
const hasProducts = products.length > 0;
const src = sub ?? cat;
const n = products.length || src.queries.length;
const updatedLong = fechaLarga(site.actualizado);

const path = sub ? `/${cat.slug}/${sub.slug}` : `/${cat.slug}`;
const canonical = new URL(withBase(path), origin).href;
const catUrl = new URL(withBase(`/${cat.slug}`), origin).href;

const h1 = sub
  ? `${sub.nombre}: los ${n} más vendidos en AliExpress`
  : tpl(cat.h1, { n });
const kicker = sub ? `${cat.nombre} · ${sub.kicker}` : cat.kicker;
const lede = sub ? sub.intro : cat.subtitulo;
const intro = sub ? "" : cat.intro;
const siblings = sub ? (cat.subcategorias ?? []).filter((s) => s.slug !== sub.slug) : [];

// CTA intermedios: después del puesto 4 y del 8.
const midCtas: Record<number, { text: string; cta: string; href: string }> = {
  4: {
    text: `¿Vas ganando? Estos son los <strong>3 primeros</strong> del ranking, los que más se llevan los lectores.`,
    cta: "Volver al top 3",
    href: "#producto-1",
  },
  8: {
    text: `Recuerda: el precio real lo ves al tocar el botón naranja. Los valores de la lista son solo <strong>referencia</strong>.`,
    cta: "Ver la comparativa",
    href: "#tabla",
  },
};

// JSON-LD — ItemList con Product embebido (rich snippets)
function priceRange(txt: string) {
  const m = String(txt).match(/(\d+)\D+(\d+)/);
  if (!m) return null;
  return { low: Number(m[1]), high: Number(m[2]) };
}
function imgAbs(src: string) {
  return /^https?:\/\//.test(src) ? src : new URL(withBase(src), origin).href;
}
const itemList = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: h1,
  numberOfItems: n,
  itemListOrder: "https://schema.org/ItemListOrderAscending",
  itemListElement: products.map((p) => {
    const pr = priceRange(p.precio_referencia);
    const rating = p._src?.rating;
    const orders = p._src?.orders;
    const product: Record<string, unknown> = {
      "@type": "Product",
      name: p.nombre,
      image: imgAbs(p.imagen),
      description: p.descripcion_corta,
      url: `${canonical}#producto-${p.rank}`,
    };
    if (pr) {
      product.offers = {
        "@type": "AggregateOffer",
        priceCurrency: "USD",
        lowPrice: pr.low,
        highPrice: pr.high,
        availability: "https://schema.org/InStock",
      };
    }
    if (typeof rating === "number" && rating > 0) {
      product.aggregateRating = {
        "@type": "AggregateRating",
        ratingValue: rating,
        bestRating: 5,
        ratingCount: typeof orders === "number" && orders > 0 ? orders : 1,
      };
    }
    return { "@type": "ListItem", position: p.rank, item: product };
  }),
};

const faqPage = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};

const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Inicio", item: new URL(withBase("/"), origin).href },
    { "@type": "ListItem", position: 2, name: cat.nombre, item: catUrl },
    ...(sub ? [{ "@type": "ListItem", position: 3, name: sub.nombre, item: canonical }] : []),
  ],
};
---

<article data-niche={cat.slug} style={`--accent:${cat.accent};--accent-wash:${cat.accentWash}`}>
  <header class="hero container">
    {
      sub && (
        <nav class="crumbs" aria-label="Ruta">
          <a href={withBase("/")}>Inicio</a>
          <span aria-hidden="true">/</span>
          <a href={withBase(`/${cat.slug}`)}>{cat.nombre}</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">{sub.nombre}</span>
        </nav>
      )
    }
    <span class="kicker">{kicker}</span>
    <h1>{h1}</h1>
    <p class="lede">{lede}</p>
    <p class="updated">
      <time datetime={site.actualizado}>Actualizado el {updatedLong}</time>
    </p>
  </header>

  <div class="container">
    {
      intro && (
        <section class="section" aria-labelledby="intro-title" style="padding-top:0">
          <h2 id="intro-title" class="sr-only">Sobre esta selección</h2>
          <p class="measure" style="color:var(--ink-2)">{intro}</p>
        </section>
      )
    }

    {
      !sub && cat.subcategorias && cat.subcategorias.length > 0 && (
        <section class="section" aria-labelledby="temas-title" style="padding-top:0">
          <div class="section-head">
            <span class="kicker">Explora por tema</span>
            <h2 id="temas-title">Rankings más específicos</h2>
          </div>
          <div class="subcat-grid">
            {cat.subcategorias.map((s) => (
              <a class="subcat-card" href={withBase(`/${cat.slug}/${s.slug}`)}>
                <span class="subcat-kicker">{s.kicker}</span>
                <strong>{s.nombre}</strong>
                <span class="go">Ver ranking <span aria-hidden="true">→</span></span>
              </a>
            ))}
          </div>
        </section>
      )
    }

    {
      !hasProducts && (
        <section class="section" style="padding-top:0">
          <div class="midcta">
            <p>Estamos armando este ranking. Vuelve en un rato — la próxima corrida automática lo completa.</p>
            <a class="btn-cta" href={withBase(sub ? `/${cat.slug}` : "/")}>
              {sub ? `Ver ${cat.nombre}` : "Ver otras categorías"} <span class="arrow" aria-hidden="true">→</span>
            </a>
          </div>
        </section>
      )
    }

    {
      hasProducts && (
        <>
          <section class="section" aria-labelledby="tabla-title" style="padding-top:0">
            <div class="section-head">
              <span class="kicker">De un vistazo</span>
              <h2 id="tabla-title">Los {n}, comparados</h2>
              <p>Toca <strong>“Ver precio”</strong> para saltar a la reseña de ese producto y abrir el enlace a AliExpress.</p>
            </div>
            <CompareTable products={products} updated={updatedLong} />
          </section>

          <section class="section" aria-labelledby="reviews-title" style="padding-top:0">
            <div class="section-head">
              <span class="kicker">El ranking</span>
              <h2 id="reviews-title">Reseña de cada producto</h2>
            </div>

            <div class="reviews">
              {products.map((p) => (
                <>
                  <ProductCard product={p} featured={p.rank === 1} />
                  {midCtas[p.rank] && (
                    <MidCta text={midCtas[p.rank].text} cta={midCtas[p.rank].cta} href={midCtas[p.rank].href} />
                  )}
                </>
              ))}
            </div>
          </section>
        </>
      )
    }

    {
      siblings.length > 0 && (
        <section class="section" aria-labelledby="hermanas-title" style="padding-top:0">
          <div class="section-head">
            <span class="kicker">Más de {cat.nombre}</span>
            <h2 id="hermanas-title">Otros temas</h2>
          </div>
          <div class="chip-row">
            {siblings.map((s) => (
              <a class="chip" href={withBase(`/${cat.slug}/${s.slug}`)}>{s.nombre}</a>
            ))}
            <a class="chip" href={withBase(`/${cat.slug}`)}>Todo {cat.nombre} ↑</a>
          </div>
        </section>
      )
    }

    <Faq items={faq} heading="Comprar en AliExpress desde Perú: dudas frecuentes" />

    {
      hasProducts && (
        <section class="section" style="padding-top:0">
          <div class="midcta">
            <p>
              Cada botón naranja lleva al comprador directo a la ficha del producto
              en AliExpress con el enlace de afiliado.
            </p>
            <a class="btn-cta" href="#tabla">Volver arriba <span class="arrow" aria-hidden="true">↑</span></a>
          </div>
        </section>
      )
    }
  </div>
</article>

{hasProducts && <StickyCta />}

<script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />
{hasProducts && <script type="application/ld+json" set:html={JSON.stringify(itemList)} />}
<script type="application/ld+json" set:html={JSON.stringify(faqPage)} />

<style>
  .sr-only {
    position: absolute; width: 1px; height: 1px;
    padding: 0; margin: -1px; overflow: hidden;
    clip: rect(0 0 0 0); white-space: nowrap; border: 0;
  }
  .reviews > :global(*) { min-width: 0; }
</style>
